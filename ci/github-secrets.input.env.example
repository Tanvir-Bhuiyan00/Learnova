# Secrets NOT stored in git. Create this file locally with your values, then run:
#   ./script/set-github-secrets.sh
# DOCKERHUB_USERNAME, DOCKERHUB_TOKEN, VPS_HOST, VPS_USER, VPS_APP_DIR and
# CLIENT_PUBLIC_API_BASE_URL come from here.
# ACCESS_TOKEN_SECRET / JWT_ACCESS_SECRET fall back to the ACCESS_TOKEN_SECRET in server/.env.production.
#
# POSTGRES_PASSWORD and SERVER_ENV_PRODUCTION are derived automatically from server/.env.production.

DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
VPS_HOST=
VPS_USER=
VPS_APP_DIR=
CLIENT_PUBLIC_API_BASE_URL=
ACCESS_TOKEN_SECRET=
JWT_ACCESS_SECRET=