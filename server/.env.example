# Learnova server environment template.
# Copy to server/.env.production for Docker deployments (the CI deploy job writes it from the SERVER_ENV_PRODUCTION GitHub secret).
# For Docker deployments DATABASE_URL must point at the compose database container (host learnova-db), NOT a remote/pooled URL.

NODE_ENV=production
PORT=5000

# In Docker Compose: postgresql://learnova:<POSTGRES_PASSWORD>@learnova-db:5432/learnova?schema=public
DATABASE_URL="postgresql://learnova:CHANGE_ME_POSTGRES_PASSWORD@learnova-db:5432/learnova?schema=public"
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

BETTER_AUTH_SECRET=CHANGE_ME
BETTER_AUTH_URL=https://learnova-lms.duckdns.org

ACCESS_TOKEN_SECRET=CHANGE_ME
REFRESH_TOKEN_SECRET=CHANGE_ME
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d
BETTER_AUTH_SESSION_TOKEN_EXPIRES_IN=1d
BETTER_AUTH_SESSION_TOKEN_UPDATE_AGE=1d

EMAIL_SENDER_SMTP_USER=CHANGE_ME@gmail.com
EMAIL_SENDER_SMTP_PASS=CHANGE_ME
EMAIL_SENDER_SMTP_HOST=smtp.gmail.com
EMAIL_SENDER_SMTP_PORT=465
EMAIL_SENDER_SMTP_FROM=CHANGE_ME@gmail.com

GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_CALLBACK_URL=https://learnova-lms.duckdns.org/api/auth/callback/google

FRONTEND_URL=https://learnova-lms.duckdns.org

CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME

STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

SUPER_ADMIN_EMAIL=CHANGE_ME@gmail.com
SUPER_ADMIN_PASSWORD=CHANGE_ME
CRON_SECRET=CHANGE_ME

# RAG Chatbot (optional)
REDIS_URL="rediss://CHANGE_ME@upstash.example:6379"
OPENROUTER_API_KEY="sk-or-v1-CHANGE_ME"
OPENROUTER_LLM_MODEL="openai/gpt-4o-mini"